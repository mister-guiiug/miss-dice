{
  "name": "miss-dice",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Lanceur de dé à 6 faces, mobile-first, 100 % offline, installable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget",
    "build:analyze": "cross-env ANALYZE=1 npm run build",
    "preview": "vite preview --base /miss-dice/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "type-check": "tsc -b",
    "prepare": "husky || true"
  },
  "bundleBudget": {
    "totalGzipKb": 125
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "@mister-guiiug/dev-pwa-config": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.0.0",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "pngjs": "^5.0.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
